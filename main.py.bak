#!/usr/bin/env python3
"""
kihobot_x - 통합 진입점
=======================
박기호논술 통합 플랫폼
 · portal       : / (메인 홈)
 · eval_engine  : /eval (평가엔진 · 논술 첨삭)
 · analy_engine : /analy (분석엔진 · 교안 · PPT)
"""
import os
import sys
import uvicorn
from pathlib import Path

from fastapi import FastAPI, Request, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.staticfiles import StaticFiles
from fastapi.responses import RedirectResponse
from starlette.middleware.sessions import SessionMiddleware
from authlib.integrations.starlette_client import OAuth

# 프로젝트 루트를 sys.path 에 추가 (모듈 import 용)
BASE = Path(__file__).resolve().parent
sys.path.insert(0, str(BASE))

from common.config import setup_logging, log_startup_info

# ── 로깅 세팅 ────────────────────────────────────────────
setup_logging()
log_startup_info()

# ── FastAPI 앱 생성 (단 한 번만 선언!) ────────────────────
app = FastAPI(
    title="kihobot_x",
    version="1.0.0",
    description="박기호논술 통합 플랫폼 - 분석엔진(교안) + 평가엔진(첨삭)",
)

# ── 미들웨어 세팅 ─────────────────────────────────────────
# 1. 세션 미들웨어 (Secret Manager에서 값 가져오기)
app.add_middleware(
    SessionMiddleware, 
    secret_key=os.getenv("SESSION_SECRET_KEY", "default_secret_key")
)

# 2. CORS 미들웨어
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

# ── OAuth 구글 로그인 세팅 ───────────────────────────────
oauth = OAuth()
oauth.register(
    name='google',
    client_id=os.getenv('GOOGLE_CLIENT_ID'),         # 수정: 환경변수에서 로드
    client_secret=os.getenv('GOOGLE_CLIENT_SECRET'), # 수정: 환경변수에서 로드
    server_metadata_url='https://accounts.google.com/.well-known/openid-configuration',
    client_kwargs={'scope': 'openid email profile'}
)

# ── 인증 미들웨어 (전역 문지기) ───────────────────────────
@app.middleware("http")
async def enforce_auth(request: Request, call_next):
    # 로그인을 검사하지 않고 통과시켜줄 경로들 (무한 루프 방지)
    public_paths = ["/login", "/auth", "/docs", "/openapi.json"]
    
    # 1. 예외 경로이거나 정적 파일(css, js 등) 요청이면 그냥 통과
    if request.url.path in public_paths or request.url.path.startswith("/static"):
        return await call_next(request)
        
    # 2. 세션에 'user' 정보가 있는지 확인
    user = request.session.get('user')
    
    # 3. 로그인 정보가 없다면 강제로 /login 페이지로 쫓아냄
    if not user:
        return RedirectResponse(url='/login')
        
    # 4. 로그인 정보가 있다면 원래 가려던 페이지로 안내
    response = await call_next(request)
    return response

# ── 인증용 라우터 ─────────────────────────────────────────
@app.get('/login')
async def login(request: Request):
    # 로그인 시도 시 구글 서버로 리디렉션
    redirect_uri = request.url_for('auth')
    # 클라우드 배포 시 https가 http로 강제 변환되는 것을 막기 위한 팁 (선택 사항)
    redirect_uri = str(redirect_uri).replace("http://", "https://") 
    return await oauth.google.authorize_redirect(request, redirect_uri)

@app.get('/auth')
async def auth(request: Request):
    # 구글에서 돌아와서 토큰을 받는 곳
    token = await oauth.google.authorize_access_token(request)
    user = token.get('userinfo')
    
    # 핵심: 도메인 체크 (@kiho1edu.com 아니면 403 에러 발생)
    if not user['email'].endswith('@kiho1edu.com'):
        raise HTTPException(status_code=403, detail="kiho1edu.com 계정만 접속 가능합니다.")
    
    # 세션에 유저 정보 저장 후 메인 페이지로 이동
    request.session['user'] = user
    return RedirectResponse(url='/')

# (참고: 기존 '/' 경로는 portal_router가 처리하므로 삭제했습니다.)

# ── 각 엔진 라우터 등록 ─────────────────────────────────
from portal.routes import router as portal_router
from eval_engine.routes import router as eval_router
from analy_engine.routes import router as analy_router

app.include_router(portal_router, tags=["portal"])
app.include_router(eval_router, prefix="/eval", tags=["eval_engine"])
app.include_router(analy_router, prefix="/analy", tags=["analy_engine"])

# ── 정적 파일 ───────────────────────────────────────────
static_dir = BASE / "common" / "static"
if static_dir.exists():
    app.mount("/static", StaticFiles(directory=str(static_dir)), name="static")

# ── 시작 훅 ─────────────────────────────────────────────
@app.on_event("startup")
def on_startup():
    from eval_engine.models import init_db
    from eval_engine.services.crud import init_default_system_prompt
    init_db()
    init_default_system_prompt()
    print("\n" + "=" * 60)
    print("  🤖 kihobot_x 통합 플랫폼 기동")
    print("=" * 60)
    print("  포털 홈:   http://localhost:8000/")
    print("  평가엔진:  http://localhost:8000/eval/")
    print("  분석엔진:  http://localhost:8000/analy/")
    print("=" * 60 + "\n")

# ── 실행 ────────────────────────────────────────────────
if __name__ == "__main__":
    host = os.getenv("HOST", "0.0.0.0")
    port = int(os.getenv("PORT", 8000))
    is_prod = os.getenv("RAILWAY_ENVIRONMENT") or os.getenv("KIHOBOT_ENV") == "production"

    uvicorn.run(
        "main:app",
        host=host,
        port=port,
        reload=not is_prod,
    )